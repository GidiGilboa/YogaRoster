DATABASE_URL="file:./dev.db"

# Secret used to sign teacher session cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Site-admin login (/admin). Username is plain; password is a bcrypt hash so
# the real plaintext password is never in source. These are the real,
# working values (committed intentionally, at Gidi's request, so every
# environment shares the same admin login without a separate secrets setup).
# To rotate the password, generate a new hash with:
#   node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" "your-new-password"
# IMPORTANT: escape every literal $ in the hash below as \$ — Next.js's .env
# loader runs dotenv-expand, which otherwise treats "$2b"/"$12" as variable
# references and silently strips them.
ADMIN_USERNAME="Admin"
ADMIN_PASSWORD_HASH="\$2b\$12\$6rQOKIkqArCd/0GyOslf6O9zTjJ3AwILsvzcHrY3UOnp9uccS3IBW"
