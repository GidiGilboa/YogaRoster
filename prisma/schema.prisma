// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Teacher {
  id                     String   @id @default(cuid())
  name                   String
  email                  String   @unique
  passwordHash           String
  phone                  String?
  appName                String   @default("Yoga Roster")
  defaultLessonCapacity  Int      @default(10)
  defaultLessonDuration  Int      @default(60)
  backgroundImageUrl     String?
  isDisabled             Boolean  @default(false)
  createdAt              DateTime @default(now())
  students               Student[]
  lessons                Lesson[]
  publications           WeeklyPlanPublication[]
}

model Student {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  firstName String
  lastName  String
  phone     String
  email     String?
  credits   Int      @default(0)
  createdAt DateTime @default(now())

  registrations Registration[]
  registrarLinks StudentLink[] @relation("RegistrarLinks")
  dependentLinks StudentLink[] @relation("DependentLinks")

  @@unique([teacherId, phone])
  @@index([teacherId])
}

model StudentLink {
  id          String   @id @default(cuid())
  registrarId String
  registrar   Student  @relation("RegistrarLinks", fields: [registrarId], references: [id])
  dependentId String
  dependent   Student  @relation("DependentLinks", fields: [dependentId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([registrarId, dependentId])
  @@index([registrarId])
  @@index([dependentId])
}

model Lesson {
  id              String   @id @default(cuid())
  teacherId       String
  teacher         Teacher  @relation(fields: [teacherId], references: [id])
  startsAt        DateTime
  durationMinutes Int
  capacity        Int
  comment         String?
  createdAt       DateTime @default(now())

  registrations Registration[]

  @@index([teacherId])
}

model Registration {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  lessonId       String
  lesson         Lesson   @relation(fields: [lessonId], references: [id])
  status         String // "registered" | "waitlisted" | "cancelled" | "attended"
  creditDeducted Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@index([studentId])
}

model WeeklyPlanPublication {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  weekStart   DateTime
  publishedAt DateTime @default(now())

  @@unique([teacherId, weekStart])
}
