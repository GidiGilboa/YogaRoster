// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Teacher {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  students     Student[]
  lessons      Lesson[]
}

model Student {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  firstName String
  lastName  String
  createdAt DateTime @default(now())

  @@index([teacherId])
}

model Lesson {
  id              String   @id @default(cuid())
  teacherId       String
  teacher         Teacher  @relation(fields: [teacherId], references: [id])
  title           String
  startsAt        DateTime
  durationMinutes Int
  capacity        Int
  comment         String?
  createdAt       DateTime @default(now())

  @@index([teacherId])
}
